{{- /* GENERATED by hack/sync-cnpg-projects.sh from charts/cnpg-cluster: do not edit. */ -}}
{{- define "cnpg-projects.cluster.objectstore" -}}
{{- if and .Values.backup.enabled .Values.backup.bucketName }}
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ .Values.clusterName }}-objectstore
  namespace: {{ .Values.namespace }}
  {{- with .Values.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  configuration:
    destinationPath: s3://{{ .Values.backup.bucketName }}/{{ include "cnpg-cluster.s3Prefix" . }}
{{- with .Values.backup.endpoint }}
    endpointURL: {{ . | quote }}
{{- end }}
{{- with .Values.backup.endpointCA }}
    endpointCA:
      name: {{ required "backup.endpointCA.name is required when endpointCA is set" .name }}
      key: {{ required "backup.endpointCA.key is required when endpointCA is set" .key }}
{{- end }}
    s3Credentials:
{{- if .Values.backup.existingSecret }}
{{- $keys := .Values.backup.existingSecretKeys | default dict }}
      accessKeyId:
        name: {{ .Values.backup.existingSecret }}
        key: {{ $keys.accessKeyId | default "AWS_ACCESS_KEY_ID" }}
      secretAccessKey:
        name: {{ .Values.backup.existingSecret }}
        key: {{ $keys.secretAccessKey | default "AWS_SECRET_ACCESS_KEY" }}
{{- with $keys.sessionToken }}
      sessionToken:
        name: {{ $.Values.backup.existingSecret }}
        key: {{ . }}
{{- end }}
{{- with $keys.region }}
      region:
        name: {{ $.Values.backup.existingSecret }}
        key: {{ . }}
{{- end }}
{{- else }}
      inheritFromIAMRole: true # the pod's ambient identity, bound by the platform
{{- end }}
    data:
      # Base backups: the CRD enum here is narrower than WAL's (no
      # zstd/xz — found by a server-side dry-run against the plugin).
      compression: {{ .Values.backup.dataCompression }}
{{- with .Values.backup.encryption }}
      encryption: {{ . }}
{{- end }}
      jobs: 2
    wal:
      compression: {{ .Values.backup.walCompression }}
{{- with .Values.backup.encryption }}
      encryption: {{ . }}
{{- end }}
      maxParallel: 4
  # The FUNCTIONAL PITR window; a bucket lifecycle rule, if any, is
  # the platform's backstop and must outlive it.
  retentionPolicy: {{ .Values.backup.retentionDays }}d
{{- end }}

{{- end -}}
