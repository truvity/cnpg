{{- /* GENERATED by hack/sync-cnpg-projects.sh from charts/cnpg-cluster: do not edit. */ -}}
{{- define "cnpg-projects.cluster.databases" -}}
{{- /* Databases (absorbs the retired cnpg-database chart) + the
shared-cluster customer shape (database-per-customer, rung 2 of the
isolation ladder): every customer gets a Database owned by the
bootstrap owner and a {customer}-access NOLOGIN role; daemon roles join
via inRoles to reach that customer. One cert, N databases, shared PITR
timeline. */}}
{{- if and (or .Values.databases .Values.customers) (not .Values.bootstrap.initdb.owner) }}
{{- fail "bootstrap.initdb.owner is required when databases or customers are declared (it is the default database/schema owner)" }}
{{- end }}
{{- /* The bootstrap database's own Database CR — adopts what initdb
created so its schemas stay declarative. Declared via
bootstrap.initdb.schemas (a STATIC project property) instead of a
databases[] entry so install tooling only ever passes the name-derived
scalars (clusterName/namespace/database/owner) and never needs to know
the project's schema list. */}}
{{- if and (eq .Values.bootstrap.mode "initdb") .Values.bootstrap.initdb.database }}
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: {{ .Values.clusterName }}-{{ .Values.bootstrap.initdb.database | replace "_" "-" }}
  namespace: {{ .Values.namespace }}
spec:
  name: {{ .Values.bootstrap.initdb.database }}
  owner: {{ .Values.bootstrap.initdb.owner }}
  ensure: present
  cluster:
    name: {{ .Values.clusterName }}
  {{- with .Values.bootstrap.initdb.schemas }}
  schemas:
    {{- range . }}
    - name: {{ . }}
      owner: {{ $.Values.bootstrap.initdb.owner }}
      ensure: present
    {{- end }}
  {{- end }}
{{- end }}
{{- range .Values.databases }}
{{- if hasPrefix "customer-" .name }}
{{- fail (printf "databases[].name %q collides with the customer-* namespace reserved for the customers list" .name) }}
{{- end }}
{{- /* Compare SLUGGED forms: metadata names normalize "_"->"-", so
"my-app" and "my_app" would collide at apply time even though the raw
names differ. */}}
{{- if eq (.name | replace "_" "-") ($.Values.bootstrap.initdb.database | default "" | replace "_" "-") }}
{{- fail (printf "databases[].name %q collides with the bootstrap database — declare its schemas via bootstrap.initdb.schemas instead" .name) }}
{{- end }}
{{- $owner := .owner | default $.Values.bootstrap.initdb.owner }}
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  # PG database names may carry underscores (my_app); K8s names may
  # not — slug the metadata, keep spec.name verbatim.
  name: {{ $.Values.clusterName }}-{{ .name | replace "_" "-" }}
  namespace: {{ $.Values.namespace }}
spec:
  name: {{ .name }}
  owner: {{ $owner }}
  ensure: {{ .ensure | default "present" }}
  cluster:
    name: {{ $.Values.clusterName }}
  {{- with .schemas }}
  schemas:
    {{- range . }}
    - name: {{ . }}
      owner: {{ $owner }}
      ensure: present
    {{- end }}
  {{- end }}
{{- end }}
{{- range .Values.customers }}
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: {{ $.Values.clusterName }}-customer-{{ .name }}
  namespace: {{ $.Values.namespace }}
spec:
  name: customer-{{ .name }}
  owner: {{ $.Values.bootstrap.initdb.owner }}
  ensure: {{ .ensure | default "present" }}
  cluster:
    name: {{ $.Values.clusterName }}
---
apiVersion: postgresql.cnpg.io/v1
kind: DatabaseRole
metadata:
  name: {{ $.Values.clusterName }}-customer-{{ .name }}-access
  namespace: {{ $.Values.namespace }}
spec:
  cluster:
    name: {{ $.Values.clusterName }}
  name: customer_{{ .name | replace "-" "_" }}_access
  ensure: present
  login: false
{{- end }}

{{- end -}}
