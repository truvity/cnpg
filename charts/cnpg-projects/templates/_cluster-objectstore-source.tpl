{{- /* GENERATED by hack/sync-cnpg-projects.sh from charts/cnpg-cluster: do not edit. */ -}}
{{- define "cnpg-projects.cluster.objectstore-source" -}}
{{- if eq .Values.bootstrap.mode "recovery" }}
{{- $src := .Values.bootstrap.recovery.source }}
{{- if $src.bucketName }}
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ .Values.clusterName }}-source-objectstore
  namespace: {{ .Values.namespace }}
spec:
  configuration:
    destinationPath: s3://{{ $src.bucketName }}/{{ $src.s3Prefix }}
{{- with $src.endpoint }}
    endpointURL: {{ . | quote }}
{{- end }}
{{- with $src.endpointCA }}
    endpointCA:
      name: {{ required "bootstrap.recovery.source.endpointCA.name is required when endpointCA is set" .name }}
      key: {{ required "bootstrap.recovery.source.endpointCA.key is required when endpointCA is set" .key }}
{{- end }}
    s3Credentials:
{{- if $src.existingSecret }}
{{- $keys := $src.existingSecretKeys | default dict }}
      accessKeyId:
        name: {{ $src.existingSecret }}
        key: {{ $keys.accessKeyId | default "AWS_ACCESS_KEY_ID" }}
      secretAccessKey:
        name: {{ $src.existingSecret }}
        key: {{ $keys.secretAccessKey | default "AWS_SECRET_ACCESS_KEY" }}
{{- with $keys.sessionToken }}
      sessionToken:
        name: {{ $src.existingSecret }}
        key: {{ . }}
{{- end }}
{{- with $keys.region }}
      region:
        name: {{ $src.existingSecret }}
        key: {{ . }}
{{- end }}
{{- else }}
      inheritFromIAMRole: true
{{- end }}
{{- end }}
{{- end }}

{{- end -}}
