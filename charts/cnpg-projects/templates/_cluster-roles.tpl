{{- /* GENERATED by hack/sync-cnpg-projects.sh from charts/cnpg-cluster: do not edit. */ -}}
{{- define "cnpg-projects.cluster.roles" -}}
{{- /* Application/technical roles. cert = operator-issued mTLS client
certificate in Secret {name}-client-cert (terminal state for apps).
password = the compatibility escape hatch: the bootstrap owner already
has the CNPG-generated {clusterName}-app Secret (declare no entry, or an
entry without passwordSecret); any OTHER password role must bring its
own kubernetes.io/basic-auth passwordSecret — the chart never generates
passwords (template-time randomness drifts under ArgoCD). Unknown auth
values fail the render. */}}
{{- range .Values.roles }}
{{- $auth := .auth | default "cert" }}
{{- if not (has $auth (list "cert" "password")) }}
{{- fail (printf "role %s: auth must be cert|password (got %q)" .name $auth) }}
{{- end }}
{{- $isOwner := eq .name $.Values.bootstrap.initdb.owner }}
{{- if and (eq $auth "password") (not $isOwner) (not .passwordSecret) }}
{{- fail (printf "role %s: auth=password on a non-owner role requires passwordSecret (the chart never generates passwords)" .name) }}
{{- end }}
{{- if not $isOwner }}
---
apiVersion: postgresql.cnpg.io/v1
kind: DatabaseRole
metadata:
  name: {{ $.Values.clusterName }}-{{ .name }}
  namespace: {{ $.Values.namespace }}
spec:
  cluster:
    name: {{ $.Values.clusterName }}
  name: {{ .name | replace "-" "_" }}
  ensure: present
  login: true
  {{- if eq $auth "cert" }}
  clientCertificate:
    enabled: true
  {{- else }}
  passwordSecret:
    name: {{ .passwordSecret }}
  {{- end }}
  {{- with .inRoles }}
  inRoles:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  databaseRoleReclaimPolicy: retain
{{- end }}
{{- end }}

{{- end -}}
