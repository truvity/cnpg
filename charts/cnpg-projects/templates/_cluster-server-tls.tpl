{{- /* GENERATED by hack/sync-cnpg-projects.sh from charts/cnpg-cluster: do not edit. */ -}}
{{- define "cnpg-projects.cluster.server-tls" -}}
{{- /* The server certificate from a cert-manager issuer (values.yaml
serverTLS). Rendered only when an issuer is named; cluster.yaml points
spec.certificates at these two Secrets under the same condition. */}}
{{- if include "cnpg-cluster.serverTLSEnabled" . }}
{{- $tls := .Values.serverTLS }}
{{- if not (trim ($tls.caCertificates | default "")) }}
{{- fail "serverTLS.caCertificates is required with serverTLS.issuerRef: it is the server CA Secret's ca.crt, what the operator, replicas and poolers verify the server with" }}
{{- end }}
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ .Values.clusterName }}-server-tls
  namespace: {{ .Values.namespace }}
  {{- with .Values.labels }}
  labels:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  secretName: {{ .Values.clusterName }}-server-tls
  # Every Service the operator creates for the cluster, fully qualified.
  # Short names (<cluster>-rw, <cluster>-rw.<ns>) are left out on purpose:
  # a private CA constrained to cluster.local cannot sign them.
  dnsNames:
    {{- range list "rw" "ro" "r" }}
    - {{ printf "%s-%s.%s.svc.cluster.local" $.Values.clusterName . $.Values.namespace }}
    {{- end }}
  {{- with $tls.duration }}
  duration: {{ . }}
  {{- end }}
  {{- with $tls.renewBefore }}
  renewBefore: {{ . }}
  {{- end }}
  {{- with $tls.privateKey }}
  privateKey:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  issuerRef:
    {{- toYaml $tls.issuerRef | nindent 4 }}
  # CloudNativePG reloads a user-provided server Secret only when it carries
  # this label; without it a cert-manager renewal is not served until the
  # instance restarts.
  secretTemplate:
    labels:
      cnpg.io/reload: "true"
---
# The roots the server chain is verified against. CNPG reads ca.crt only;
# with serverTLSSecret set it needs no ca.key.
apiVersion: v1
kind: Secret
metadata:
  name: {{ .Values.clusterName }}-server-ca
  namespace: {{ .Values.namespace }}
  labels:
    cnpg.io/reload: "true"
    {{- with .Values.labels }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
type: Opaque
data:
  ca.crt: {{ printf "%s\n" (trim $tls.caCertificates) | b64enc }}
{{- end }}

{{- end -}}
