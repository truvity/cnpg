{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cnpg-database",
  "description": "What a product installs against the CNPG cluster the platform gave it: Databases, unprivileged DatabaseRoles and per-role client Certificates, in the release namespace. See docs/reference.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clusterName"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm injects `global` into every subchart's values, so a strict schema must admit it or the chart cannot be embedded as a dependency. The chart reads nothing from it."
    },
    "clusterName": {
      "type": "string",
      "description": "Name of the platform's CNPG Cluster (a DNS label). Required."
    },
    "namespace": {
      "type": "string",
      "description": "Optional; must equal the release namespace when set."
    },
    "databaseName": {
      "type": "string",
      "description": "The primary database (spec.name). Empty renders none."
    },
    "owner": {
      "type": "string",
      "description": "Owner of the primary database and default owner of databases[]. Defaults to 'app'."
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "description": "PostgreSQL database name."
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "ensure": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "databaseReclaimPolicy": {
            "enum": [
              "retain",
              "delete"
            ]
          },
          "schemas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "description": "Role name; never pg_*. Also the certificate commonName."
          },
          "ensure": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "login": {
            "type": "boolean"
          },
          "inherit": {
            "type": "boolean"
          },
          "inRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "connectionLimit": {
            "type": "integer",
            "minimum": -1
          },
          "passwordSecret": {
            "type": "string"
          },
          "disablePassword": {
            "type": "boolean"
          },
          "validUntil": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "databaseRoleReclaimPolicy": {
            "enum": [
              "retain",
              "delete"
            ]
          },
          "clientCertificate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "algorithm": {
                "enum": [
                  "ECDSA",
                  "RSA"
                ]
              },
              "size": {
                "type": [
                  "integer",
                  "null"
                ],
                "enum": [
                  256,
                  384,
                  521,
                  2048,
                  3072,
                  4096,
                  null
                ]
              },
              "duration": {
                "type": "string"
              },
              "renewBefore": {
                "type": "string"
              },
              "issuerRef": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "ClusterIssuer",
                      "Issuer"
                    ]
                  },
                  "group": {
                    "type": "string"
                  }
                }
              },
              "additionalOutputFormats": {
                "type": "array",
                "items": {
                  "enum": [
                    "DER"
                  ]
                }
              }
            }
          },
          "superuser": {
            "description": "Refused at render time: a product manages unprivileged roles only."
          },
          "replication": {
            "description": "Refused at render time: a product manages unprivileged roles only."
          },
          "bypassrls": {
            "description": "Refused at render time: a product manages unprivileged roles only."
          },
          "createrole": {
            "description": "Refused at render time: a product manages unprivileged roles only."
          },
          "createdb": {
            "description": "Refused at render time: a product manages unprivileged roles only."
          }
        }
      }
    },
    "clientCertificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "ECDSA",
            "RSA"
          ]
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            256,
            384,
            521,
            2048,
            3072,
            4096,
            null
          ]
        },
        "duration": {
          "type": "string"
        },
        "renewBefore": {
          "type": "string"
        },
        "additionalOutputFormats": {
          "type": "array",
          "items": {
            "enum": [
              "DER"
            ]
          }
        }
      }
    },
    "clientCertificateIssuerRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ClusterIssuer",
            "Issuer"
          ]
        },
        "group": {
          "type": "string"
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string"
        },
        "databaseName": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "description": "Optional exact-match assertions; a mismatch fails the render."
    },
    "allowedConsumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "RETIRED: no-op, kept for values compatibility."
    }
  }
}
