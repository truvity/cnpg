/// A CNPG Cluster whose posture is chosen by a platform-injected profile. See docs/reference.md for the full value-by-value reference.
@A.Chart { title = "cnpg-cluster" }
module cnpg.contracts.Cluster

import "@vocab/Annotations.pkl" as A
import "@vocab/Vocab.pkl" as V

import "../Common.pkl"

/// Helm injects `global` into every subchart's values, so a strict schema must admit it or the chart cannot be embedded as a dependency. The chart reads nothing from it.
global: Dynamic?

/// Name of the CNPG Cluster and the prefix for every resource this chart renders.
clusterName: String?

/// Namespace the Cluster and its companion resources are rendered into.
namespace: String?

/// Platform-injected posture: 'devel' (1 instance, no PDB) or 'prod' (3 instances, PDB, quorum failover, WAL volume). Required — an empty/unset value fails the render rather than silently choosing a posture.
profile: Profile?

/// Annotations stamped on the Cluster CR and on the ObjectStore.
annotations: Mapping<String, String>?

/// Labels stamped on the Cluster CR and, via inheritedMetadata, fanned out to its Pods/PVCs/Services by the operator's INHERITED_LABELS setting.
labels: Mapping<String, String>?

/// Backup coordinates: the bucket and identity that may write to it are the platform's to mint and hand in here.
backup: Backup?

/// How the cluster's first database comes to exist: a fresh initdb, or recovery from an archive.
bootstrap: Bootstrap?

/// Additional databases in this cluster (absorbs the retired cnpg-database chart).
databases: Listing<Database>?

/// Shared-cluster, database-per-customer shape: each entry renders a Database owned by the bootstrap owner plus a '{name}-access' NOLOGIN role.
customers: Listing<Customer>?

/// Application/technical roles rendered as DatabaseRole CRs.
roles: Listing<Role>?

/// Instance count. Null = profile default (devel 1, prod 3). prod requires >= 3.
// The schema also admits null (profile default): said in Gaps.pkl.
@A.Range { min = 1 }
instances: Int?

storage: Storage?

walStorage: WalStorage?

/// Raw Kubernetes ResourceRequirements. Empty = profile default (devel 100m/256Mi req + 512Mi limit; prod 250m/512Mi req + 1Gi limit). A set value replaces the default wholesale.
resources: Dynamic?

postgresql: Postgresql?

enableSuperuserAccess: Boolean?

/// Optional: take the SERVER certificate from a cert-manager issuer instead of the operator's own self-signed CA. Client CA, replication and pg_hba are unaffected.
serverTLS: ServerTLS?

/// Optional per-database client trust, installed by the platform once per cluster.
trust: Trust?

replication: Replication?

/// Humans authenticating with a client certificate whose CN is the email; rows of the people pg_ident map.
people: Listing<Person>?

/// Metrics scraping of the instance pods.
monitoring: Monitoring?

/// Node placement. Both keys are estate facts (a pool name, a taint) and have no default — set them to reproduce a specific platform's shape.
scheduling: Scheduling?

class BackupEndpointCA {
  /// Name of the Secret.
  name: String?

  /// Key inside the Secret holding the PEM bundle.
  key: String?
}

class BackupExistingSecretKeys {
  accessKeyId: String?

  secretAccessKey: String?

  sessionToken: String?

  region: String?
}

class Backup {
  /// Turns on continuous WAL archiving and renders the backup ObjectStore. Empty bucketName keeps archiving off even when true.
  enabled: Boolean?

  /// Whether this cluster is meant to be backed up. false opts out of the platform's 'backup not configured' alert and requires notExpectedReason.
  expected: Boolean?

  /// Why the cluster is deliberately not backed up. Required, non-empty, when expected is false.
  notExpectedReason: String?

  /// S3 (or S3-compatible) bucket backups are written to. Empty = archiving off.
  bucketName: String?

  /// Prefix under the bucket. Defaults to '{namespace}/{clusterName}/' when empty.
  s3Prefix: String?

  /// Barman server directory under the prefix. Defaults to clusterName. Bump on a recreated (fresh initdb) cluster so it does not reuse its predecessor's archive directory.
  serverName: String?

  /// Cron schedule for the ScheduledBackup, e.g. '0 0 2 * * *'.
  schedule: String?

  /// Take the first base backup as soon as the ScheduledBackup is created rather than at the first cron tick. Ignored by the operator on a ScheduledBackup that has already run.
  immediate: Boolean?

  /// Functional PITR window, enforced by the barman-cloud plugin's pruning.
  @A.Range { min = 0 }
  retentionDays: Int?

  /// WAL segment compression algorithm passed to the barman-cloud plugin.
  walCompression: String?

  /// Base backup compression algorithm passed to the barman-cloud plugin (a narrower enum than WAL's).
  dataCompression: String?

  /// Server-side encryption header requested on every upload (e.g. AES256). Empty sends no x-amz-server-side-encryption header, which is required by stores that reject it (Cloudflare R2 among them).
  encryption: String?

  /// S3-compatible endpoint URL (Cloudflare R2, MinIO, Ceph RGW, ...). Empty keeps the AWS endpoint.
  endpoint: String?

  /// Secret holding the PEM bundle that verifies a private endpoint's certificate. Both keys are required together.
  endpointCA: BackupEndpointCA?

  /// Name of an existing Secret with static AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY. Empty keeps the pod's ambient identity (inheritFromIAMRole).
  existingSecret: String?

  /// Key names read from existingSecret. sessionToken and region are only referenced when named.
  existingSecretKeys: BackupExistingSecretKeys?
}

class BootstrapInitdb {
  /// Bootstrap database name. Empty renders no initdb bootstrap block.
  database: String?

  /// Technical owner role for the bootstrap database (used by migration jobs, not interactively). Also the implicit owner for entries in databases[]/customers[] that don't set their own.
  owner: String?

  /// Declarative schemas on the bootstrap database.
  schemas: Listing<String>?
}

class SourceEndpointCA {
  name: String?

  key: String?
}

class SourceExistingSecretKeys {
  accessKeyId: String?

  secretAccessKey: String?

  sessionToken: String?

  region: String?
}

class RecoverySource {
  bucketName: String?

  s3Prefix: String?

  /// Defaults to clusterName when empty.
  serverName: String?

  endpoint: String?

  endpointCA: SourceEndpointCA?

  existingSecret: String?

  existingSecretKeys: SourceExistingSecretKeys?
}

class RecoveryTarget {
  /// PITR target timestamp. Empty recovers to the latest available point.
  targetTime: String?

  exclusive: Boolean?
}

class BootstrapRecovery {
  /// The archive to recover from; may be a different store than the one this cluster archives to going forward.
  source: RecoverySource?

  target: RecoveryTarget?
}

class Bootstrap {
  /// 'initdb' creates a fresh database; 'recovery' bootstraps from bootstrap.recovery.source.
  mode: BootstrapMode?

  initdb: BootstrapInitdb?

  recovery: BootstrapRecovery?
}

class Database {
  name: String

  /// Defaults to bootstrap.initdb.owner when empty.
  owner: String?

  schemas: Listing<String>?

  ensure: Ensure?
}

class Customer {
  name: String

  ensure: Ensure?
}

class Role {
  name: String

  /// cert = operator-issued mTLS client certificate; password = the compatibility path, which requires passwordSecret.
  auth: RoleAuth?

  inRoles: Listing<String>?

  /// Existing kubernetes.io/basic-auth Secret. Required when auth=password on a non-owner role; the chart never generates passwords.
  passwordSecret: String?
}

class Storage {
  /// Empty = profile default (devel 2Gi, prod 10Gi).
  size: String?

  /// Empty = profile default (devel cnpg-gp3-delete, prod cnpg-gp3).
  storageClass: String?
}

class WalStorage {
  /// WAL volume size. prod only; devel skips the WAL volume entirely.
  size: String?
}

class PostgresqlPgHba {
  /// Extra pg_hba.conf lines placed before the catch-all cert line.
  beforeCatchAll: Listing<String>?
}

class Postgresql {
  /// Extra postgresql.conf parameters, merged over the profile's own (synchronous_commit, shared_buffers, max_slot_wal_keep_size).
  parameters: Dynamic?

  /// Extra pg_hba.conf lines, appended AFTER the catch-all cert line, where first-match hba never reaches them. Kept for compatibility; use pgHba.beforeCatchAll.
  extra_pg_hba: Listing<String>?

  pgHba: PostgresqlPgHba?
}

class ServerTLSIssuerRef {
  /// Empty name = the operator's own CA (default).
  name: String?

  kind: String?

  group: String?
}

class ServerTLS {
  issuerRef: ServerTLSIssuerRef?

  duration: String?

  renewBefore: String?

  /// Passed through to the Certificate's spec.privateKey, e.g. {algorithm: ECDSA, size: 384}.
  privateKey: Dynamic?

  /// PEM roots that verify the issued chain. Required when issuerRef.name is set.
  caCertificates: String?

  /// Names-only mode: an existing kubernetes.io/tls Secret for the server certificate. Set together with existingCASecret, not with issuerRef. Its producer must label it cnpg.io/reload.
  existingSecret: String?

  /// Names-only mode: an existing Secret holding the server CA in ca.crt. Set together with existingSecret, not with issuerRef. Its producer must label it cnpg.io/reload.
  existingCASecret: String?
}

class TrustCa {
  enabled: Boolean?

  duration: String?

  renewBefore: String?
}

class PolicyRequester {
  name: V.DnsLabel?

  namespace: V.DnsLabel?
}

class TrustPolicy {
  enabled: Boolean?

  /// Common names the policy admits, besides streaming_replica.
  roles: Listing<PolicyRole>?

  requester: PolicyRequester?
}

class TrustBundle {
  enabled: Boolean?

  /// Extra PEM roots added to the client CA bundle.
  extraCertificates: Listing<PemRoot>?
}

class Trust {
  /// cert-manager's cluster resource namespace, also trust-manager's trust namespace. Required with ca or bundle.
  namespace: TrustNamespace?

  ca: TrustCa?

  policy: TrustPolicy?

  bundle: TrustBundle?
}

class Replication {
  enabled: Boolean?

  /// Secret written by the replication Certificate and named by spec.certificates.replicationTLSSecret. Empty = <clusterName>-replication-tls.
  secretName: SecretNameOrEmpty?
}

class Person {
  email: Email

  /// The database role the person may connect as. pg_ prefixes are refused.
  role: PersonRole
}

class MonitoringPodMonitor {
  /// Render a monitoring.coreos.com/v1 PodMonitor for the instance pods (port metrics, /metrics) when the cluster serves that API. Default true.
  enabled: Boolean?

  /// Scrape interval, e.g. 30s. Empty = the scraper's default.
  interval: String?

  /// Drop the cnpg_pg_settings_* metric family (roughly 500-700 series per instance). Default true.
  dropPgSettings: Boolean?

  /// Settings (the name label of cnpg_pg_settings_setting) kept when dropPgSettings is on. Empty = drop the whole family.
  keepPgSettings: Listing<Common.PgSetting>?

  /// Passed through to the endpoint after the pg_settings drop; write action explicitly on every rule.
  metricRelabelings: Listing<Dynamic>?

  /// Extra labels on the PodMonitor object.
  labels: Mapping<String, String>?
}

class MonitoringNetworkPolicy {
  /// Optional. Unset = render exactly when from is non-empty. true with an empty from fails the render; false suppresses the object.
  enabled: Boolean?

  /// NetworkPolicyPeer entries allowed to reach the metrics port (TCP 9187). Empty = no NetworkPolicy.
  `from`: Listing<Dynamic>?

  /// Extra labels on the NetworkPolicy.
  labels: Mapping<String, String>?
}

class Monitoring {
  podMonitor: MonitoringPodMonitor?

  networkPolicy: MonitoringNetworkPolicy?
}

class Scheduling {
  /// Karpenter (or any) node pool name. Selects nodeSelector 'karpenter.sh/nodepool' and adds a matching Equal/NoSchedule toleration automatically. Empty/absent = no pool, no nodeSelector, no pool toleration.
  databasePool: String?

  /// Extra raw Kubernetes tolerations (passthrough — left open, like resources above), appended after the pool's own (if any). Empty/absent = none.
  tolerations: Listing<Dynamic>?
}

typealias Profile = "" | "devel" | "prod"

typealias BootstrapMode = "initdb" | "recovery"

typealias Ensure = "present" | "absent"

typealias RoleAuth = "cert" | "password"

local const trustNamespaceRe = #"^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"#
local const policyRoleRe = #"^[a-z_][a-z0-9_-]{0,62}$"#
local const personRoleRe = #"^[a-z_][a-z0-9_]{0,62}$"#
local const pemRootRe = "BEGIN CERTIFICATE"
local const secretNameOrEmptyRe = #"^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"#
local const emailRe = ##"^[^\s"#\\,]+@[^\s"#\\,]+$"##

/// A DNS label or empty, at most 63 characters (the vocabulary's `DnsLabel` is never empty).
@A.Length { max = 63 }
@A.Pattern {
  regex = trustNamespaceRe
  valid { ""; "cert-manager" }
  invalid { "-a"; "A" }
}
typealias TrustNamespace = String(length <= 63 && contains(Regex(trustNamespaceRe)))

/// A role common name the trust policy admits.
@A.Pattern {
  regex = policyRoleRe
  valid { "app"; "_a-1" }
  invalid { ""; "1a"; "A" }
}
typealias PolicyRole = String(contains(Regex(policyRoleRe)))

/// A database role a person may connect as.
@A.Pattern {
  regex = personRoleRe
  valid { "app"; "_a1" }
  invalid { ""; "1a"; "a-b" }
}
typealias PersonRole = String(contains(Regex(personRoleRe)))

/// An extra PEM root; only the words "BEGIN CERTIFICATE" are checked.
@A.Pattern {
  regex = pemRootRe
  valid { "BEGIN CERTIFICATE" }
  invalid { "not a certificate" }
}
typealias PemRoot = String(contains(Regex(pemRootRe)))

/// A Secret name, or empty.
@A.Pattern {
  regex = secretNameOrEmptyRe
  valid { ""; "a-b.c" }
  invalid { "-a"; "A" }
}
typealias SecretNameOrEmpty = String(contains(Regex(secretNameOrEmptyRe)))

/// An email address: something, an `@`, something, with no white space, quote, `#`, backslash or comma.
@A.Pattern {
  regex = emailRe
  valid { "a@b" }
  invalid { "ab"; "a b@c"; "a,b@c" }
}
typealias Email = String(contains(Regex(emailRe)))
