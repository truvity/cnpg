/// What `contracts.helm` v0.5.0 cannot say, applied to its output so that the
/// generated `values.schema.json` accepts and refuses exactly what the
/// hand-written one did. Each item names the rule it keeps and is a follow-up
/// for the generators; when one is fixed upstream its code is deleted here.
module cnpg.contracts.Gaps

import "@helm/Helm.pkl"
import "@jsonschema/JsonSchema.pkl"
import "@model/Model.pkl"

/// The schema of the chart whose values class is `root`.
function schema(root: Model.Node): Dynamic =
  let (base = Helm.valuesSchema(root))
  let (withDefs = withDefinitions(base, root))
  let (plain = withoutGuards(withDefs) as Dynamic)
    (fixes.getOrNull(root.cls.qname) ?? (s) -> s).apply(plain)

/// What is specific to one chart, by the contract module's name.
local fixes: Mapping<String, (Dynamic) -> Dynamic> = new {
  // `instances: null` means the profile's default, and the chart's own
  // values.yaml says so: an integer from 1, or null (v0.5.0 never admits null).
  ["Cluster"] = (s) -> (s) {
    ["properties"] { ["instances"] { ["type"] = List("integer", "null") } }
  }
  ["Database"] = (s) -> (s) {
    ["properties"] {
      ["roles"] {
        ["items"] {
          ["properties"] { ["clientCertificate"] { ["properties"] { ["size"] = keySize } } }
        }
      }
      ["clientCertificate"] { ["properties"] { ["size"] = keySize } }
    }
  }
}

/// An RSA or ECDSA key size, or null for the issuer's default: a number from a
/// list that also admits `null`. v0.5.0 has neither a numeric enum nor a null
/// member (`null` is never a value of an optional field there).
local keySize: Dynamic = new Dynamic {
  ["type"] = List("integer", "null")
  ["enum"] = List(256, 384, 521, 2048, 3072, 4096, null)
}

/// `@Def` definitions of the chart's own values. v0.5.0 emits `$defs` only for
/// `@Schema` documents, so a `$ref: #/$defs/<name>` to a definition of the chart
/// itself would dangle.
local function withDefinitions(base: Dynamic, root: Model.Node): Dynamic = (base) {
  ["$defs"] {
    for (
      d in
        Model
          .walk(root)
          .filter((n) -> n.def != null)
          .distinctBy((n) -> n.def.name)
    ) {
      [d.def.name] = JsonSchema.ofNode((d) { def = null })
    }
  }
}

/// v0.5.0 pairs every `pattern` with `not: { pattern: <line breaks> }`. The
/// hand-written patterns do not refuse a line break (a PEM certificate is
/// several lines, and `caCertificates` is matched by an unanchored pattern), so
/// the guard is removed to keep today's rule. Adopting the guard is a decision
/// of its own (it would refuse every real PEM here), not part of this move.
/// The same walk drops an empty `$defs`, which the generator always writes.
local function withoutGuards(v: Any): Any =
  if (v is Dynamic)
    new Dynamic {
      for (k, x in v.toMap()) {
        when (!(k == "not" && isGuard(x)) && !(k == "$defs" && x is Dynamic && x.toMap().isEmpty)) {
          [k] = withoutGuards(x)
        }
      }
    }
  else if (v is List)
    v.map((e) -> withoutGuards(e))
  else if (v is Listing)
    v.toList().map((e) -> withoutGuards(e))
  else
    v

local function isGuard(x: Any): Boolean =
  x is Dynamic && x.toMap() == Map("pattern", Model.lineBreakClass)
