{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDeleteObjectVersionFromExternalAccount",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:DeleteObjectVersion",
      "Resource": "arn:testpart:s3:::example-backup/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "dst-account"
        }
      }
    },
    {
      "Sid": "DenyDeleteObjectsFromExternalAccount",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:testpart:s3:::example-backup/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "dst-account"
        }
      }
    },
    {
      "Sid": "DenyBucketConfigurationFromExternalAccount",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutReplicationConfiguration",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": "arn:testpart:s3:::example-backup",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "dst-account"
        }
      }
    },
    {
      "Sid": "DenyPutObjectWithoutSSES3",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:testpart:s3:::example-backup/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "AllowTenant1ArchiveObjects",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:testpart:iam::src-account:root"
      },
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:GetObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:testpart:s3:::example-backup/<namespace-a>/<cluster-a>/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-archive",
          "aws:PrincipalTag/eks-cluster-name": "<eks-cluster>",
          "aws:PrincipalTag/kubernetes-namespace": "<namespace-a>",
          "aws:PrincipalTag/kubernetes-service-account": "<cluster-a>"
        }
      }
    },
    {
      "Sid": "AllowTenant1ArchiveListBucket",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:testpart:iam::src-account:root"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:testpart:s3:::example-backup",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-archive",
          "aws:PrincipalTag/eks-cluster-name": "<eks-cluster>",
          "aws:PrincipalTag/kubernetes-namespace": "<namespace-a>",
          "aws:PrincipalTag/kubernetes-service-account": "<cluster-a>"
        },
        "StringLike": {
          "s3:prefix": [
            "<namespace-a>/<cluster-a>/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowTenant2RestoreObjects",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:testpart:iam::src-account:root"
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:testpart:s3:::example-backup/<namespace-b>/<cluster-b>/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-restore"
        }
      }
    },
    {
      "Sid": "AllowTenant2RestoreListBucket",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:testpart:iam::src-account:root"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:testpart:s3:::example-backup",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-restore"
        },
        "StringLike": {
          "s3:prefix": [
            "<namespace-b>/<cluster-b>/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyTenantRole1OutsideItsPrefix",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:*",
      "NotResource": [
        "arn:testpart:s3:::example-backup",
        "arn:testpart:s3:::example-backup/<namespace-a>/<cluster-a>/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-archive"
        }
      }
    },
    {
      "Sid": "DenyTenantRole1ListOutsideItsPrefix",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:testpart:s3:::example-backup",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-archive"
        },
        "StringNotLike": {
          "s3:prefix": [
            "<namespace-a>/<cluster-a>/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyTenantRole2OutsideItsPrefix",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:*",
      "NotResource": [
        "arn:testpart:s3:::example-backup",
        "arn:testpart:s3:::example-backup/<namespace-b>/<cluster-b>/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-restore"
        }
      }
    },
    {
      "Sid": "DenyTenantRole2ListOutsideItsPrefix",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:testpart:s3:::example-backup",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:testpart:iam::src-account:role/pg-restore"
        },
        "StringNotLike": {
          "s3:prefix": [
            "<namespace-b>/<cluster-b>/*"
          ]
        }
      }
    }
  ]
}
