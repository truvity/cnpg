[
  {
    "type": "aws:s3/bucketLifecycleConfigurationV2:BucketLifecycleConfigurationV2",
    "name": "example-backup-lifecycle",
    "parent": "urn:pulumi:dev::example::truvity:cnpg/aws:BackupStore::backup",
    "inputs": {
      "bucket": "example-backup-id",
      "rules": [
        {
          "expiration": {
            "days": 30
          },
          "filter": {
            "tag": {
              "key": "cnpg-backup-retention",
              "value": "managed"
            }
          },
          "id": "managed",
          "status": "Enabled"
        },
        {
          "abortIncompleteMultipartUpload": {
            "daysAfterInitiation": 7
          },
          "expiration": {
            "expiredObjectDeleteMarker": true
          },
          "filter": {
            "prefix": ""
          },
          "id": "housekeeping",
          "noncurrentVersionExpiration": {
            "noncurrentDays": 7
          },
          "status": "Enabled"
        }
      ]
    }
  }
]
